  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.js",
    "prepare": "husky",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:fresh": "mikro-orm schema:drop --run && mikro-orm migration:up",
    "schema:update": "mikro-orm schema:update --run",
    "schema:fresh": "mikro-orm schema:fresh --run",
    "seeder:run": "mikro-orm seeder:run",
    "seeder:create": "mikro-orm seeder:create",
    "db:fresh": "mikro-orm schema:fresh --run && mikro-orm seeder:run",
    "cache:clear": "mikro-orm cache:clear"
  },
